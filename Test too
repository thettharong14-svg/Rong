openCorner.Parent = open

-- Get checkpoint position
local function getCheckpoint(checkpoint)
	if checkpoint:IsA("BasePart") then
		return checkpoint.CFrame
	elseif checkpoint:IsA("Model") then
		return checkpoint:GetPivot()
	end

	return nil
end

-- Teleport loop
local function startAutoFarm()
	if running then return end

	running = true

	task.spawn(function()
		while running and currentCheckpoint <= MAX_CHECKPOINT do

			local checkpoint =
				checkpoints:FindFirstChild(tostring(currentCheckpoint))

			if checkpoint then
				local character = player.Character

				if character then
					local root =
						character:FindFirstChild("HumanoidRootPart")

					local cf = getCheckpoint(checkpoint)

					if root and cf then
						root.CFrame =
							cf + Vector3.new(0, 3, 0)
					end
				end

				currentCheckpoint += 1
			else
				-- If checkpoint doesn't exist, skip it
				currentCheckpoint += 1
			end

			task.wait(DELAY)
		end

		running = false
	end)
end

-- Start
start.MouseButton1Click:Connect(function()
	if currentCheckpoint > MAX_CHECKPOINT then
		currentCheckpoint = 1
	end

	startAutoFarm()
end)

-- Stop
stop.MouseButton1Click:Connect(function()
	running = false
end)

-- Close
close.MouseButton1Click:Connect(function()
	frame.Visible = false
	open.Visible = true
end)

-- Open
open.MouseButton1Click:Connect(function()
	frame.Visible = true
	open.Visible = false
end)

-- Mobile dragging
local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

title.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = false
	end
end)

title.InputChanged:Connect(function(input)
	if dragging then
		local delta = input.Position - dragStart

		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
