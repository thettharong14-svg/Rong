	end
end)

--==================================================
-- AIM UPDATE
--==================================================

RunService.RenderStepped:Connect(function()

	if not AimEnabled then
		return
	end

	local target = GetClosestTarget()

	if not target then
		return
	end

	local cameraPosition =
		Camera.CFrame.Position

	local targetCFrame =
		CFrame.lookAt(
			cameraPosition,
			target.Position
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			targetCFrame,
			AIM_SMOOTHNESS
		)
end)

