openCorner.CornerRadius = UDim.new(0, 8)
openCorner.Parent = openButton

--// Update display
local function updateText()
	checkpointText.Text =
		"Checkpoint: " .. currentCheckpoint .. " / " .. lastCheckpoint
end

--// Get checkpoint
local function getCheckpoint(number)
	return checkpoints:FindFirstChild(tostring(number))
end

--// Teleport
local function teleportToCheckpoint(number)
	local character = player.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local checkpoint = getCheckpoint(number)

	if not checkpoint then
		status.Text = "Checkpoint " .. number .. " not found!"
		return
	end

	if checkpoint:IsA("BasePart") then
		root.CFrame = checkpoint.CFrame + Vector3.new(0, 4, 0)

	elseif checkpoint:IsA("Model") then
		root.CFrame =
			checkpoint:GetPivot() + Vector3.new(0, 4, 0)

	else
		status.Text = "Invalid checkpoint!"
		return
	end

	currentCheckpoint = number
	updateText()

	status.Text = "Teleported!"
end

--// Previous
previousButton.MouseButton1Click:Connect(function()
	if currentCheckpoint > 1 then
		currentCheckpoint -= 1
		updateText()
		status.Text = "Checkpoint selected"
	else
		status.Text = "Already at checkpoint 1"
	end
end)

--// Next
nextButton.MouseButton1Click:Connect(function()
	if currentCheckpoint < lastCheckpoint then
		currentCheckpoint += 1
		updateText()
		status.Text = "Checkpoint selected"
	else
		status.Text = "Already at last checkpoint"
	end
end)

--// Teleport selected
teleportButton.MouseButton1Click:Connect(function()
	teleportToCheckpoint(currentCheckpoint)
end)

--// Last checkpoint
lastButton.MouseButton1Click:Connect(function()
	currentCheckpoint = lastCheckpoint
	updateText()
	teleportToCheckpoint(lastCheckpoint)
end)

--// Close
closeButton.MouseButton1Click:Connect(function()
	box.Visible = false
	openButton.Visible = true
end)

--// Open
openButton.MouseButton1Click:Connect(function()
	box.Visible = true
	openButton.Visible = false
end)

-- Initial
updateText()
