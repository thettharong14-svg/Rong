-- Function to make buttons
local function makeButton(text, position)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 105, 0, 38)
	button.Position = position
	button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	button.Text = text
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 14
	button.Font = Enum.Font.GothamBold
	button.BorderSizePixel = 0
	button.Parent = box

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = button

	return button
end

local previousButton = makeButton(
	"◀ PREVIOUS",
	UDim2.new(0, 10, 0, 95)
)

local nextButton = makeButton(
	"NEXT ▶",
	UDim2.new(0, 125, 0, 95)
)

local teleportButton = makeButton(
	"TELEPORT",
	UDim2.new(0, 10, 0, 140)
)

local lastButton = makeButton(
	"LAST 🏁",
	UDim2.new(0, 125, 0, 140)
)

