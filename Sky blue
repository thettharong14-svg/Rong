local function setButton(button,active,onText,offText)

	button:SetAttribute("Active",active)

	if active then

		button.Text = onText
		button.BackgroundColor3 =
			Color3.fromRGB(35,145,210)

	else

		button.Text = offText
		button.BackgroundColor3 =
			Color3.fromRGB(25,55,75)

	end
end

