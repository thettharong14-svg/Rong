--==================================================
-- DASH FUNCTION
--==================================================

local function Dash()

	if not DashEnabled then
		return
	end

	if not CanDash then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local Humanoid =
		Character:FindFirstChildOfClass("Humanoid")

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not Root then
		return
	end

	CanDash = false

	local Direction =
		Humanoid.MoveDirection

	-- If player isn't moving,
	-- dash in the direction they're facing.
	if Direction.Magnitude < 0.05 then
		Direction = Root.CFrame.LookVector
	else
		Direction = Direction.Unit
	end

	local OldY =
		Root.AssemblyLinearVelocity.Y

	Root.AssemblyLinearVelocity =
		Vector3.new(
			Direction.X * DASH_POWER,
			OldY,
			Direction.Z * DASH_POWER
		)

	-- Short dash burst
	task.delay(DASH_TIME, function()

		if Root and Root.Parent then

			local Velocity =
				Root.AssemblyLinearVelocity

			Root.AssemblyLinearVelocity =
				Vector3.new(
					Velocity.X * 0.35,
					Velocity.Y,
					Velocity.Z * 0.35
				)
		end
	end)

	-- Cooldown
	task.delay(DASH_COOLDOWN, function()
		CanDash = true
	end)
end

--==================================================
-- DASH ON / OFF
--==================================================

DashToggle.Activated:Connect(function()

	DashEnabled = not DashEnabled

	if DashEnabled then

		DashToggle.Text =
			"💨 DASH: ON"

		DashToggle.BackgroundColor3 =
			Color3.fromRGB(30, 150, 220)

		-- Show dash button
		DashMobile.Visible = true

	else

		DashToggle.Text =
			"💨 DASH: OFF"

		DashToggle.BackgroundColor3 =
			Color3.fromRGB(20, 65, 90)

		-- Hide dash button
		DashMobile.Visible = false
	end
end)

--==================================================
-- MOBILE DASH
--==================================================

DashMobile.Activated:Connect(function()
	Dash()
end)

